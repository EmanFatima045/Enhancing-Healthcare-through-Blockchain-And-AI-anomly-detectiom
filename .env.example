# Copy to .env for local development. Generate a unique value; never commit the real secret.
HEALER_SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-local-password
HEALER_ENV=development
HEALER_DEMO_MODE=false
HEALER_OUTBOX_POLL_SECONDS=5
DATABASE_URL=sqlite:///backend/data/healerplus.db
HEALER_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
HEALER_TRUSTED_HOSTS=127.0.0.1,localhost
HEALER_TRUST_PROXY_HEADERS=false
HEALER_TRUSTED_PROXIES=127.0.0.1,::1

# Optional live read-only blockchain verification.
ETH_RPC_URL=
CHAIN_ID=31337
HEALER_APP_DOMAIN=127.0.0.1:3000
HEALER_CHAIN_CONFIRMATIONS=1
HEALER_AUTH_CONTRACT_ADDRESS=
CONSENT_MANAGER_CONTRACT_ADDRESS=
MEDICAL_AUDIT_CONTRACT_ADDRESS=
BREAK_GLASS_CONTRACT_ADDRESS=

# Optional narrowly scoped backend writer. Never use a patient/admin wallet key.
HEALER_SERVICE_SIGNER_PRIVATE_KEY=
HEALER_STAFF_ADMIN_PRIVATE_KEY=
HEALER_SERVICE_SIGNER_SCOPES=STAFF_ADMIN,RECORD_ANCHOR,INCIDENT_ATTESTATION

# Optional institutional emergency escrow. The private PEM path is backend-only.
HEALER_EMERGENCY_ESCROW_EMAIL=
HEALER_EMERGENCY_ESCROW_PRIVATE_KEY_PATH=
HEALER_NOTIFICATION_SINK=local
HEALER_SMTP_HOST=
HEALER_SMTP_PORT=587
HEALER_SMTP_USERNAME=
HEALER_SMTP_PASSWORD=
HEALER_SMTP_FROM=
HEALER_CARE_TEAM_EMAIL=
HEALER_SMTP_STARTTLS=true
HEALER_MODEL_ARTIFACT_DIR=backend/app/ml/artifacts

# Encrypted-envelope storage. Credentials are backend-only and must never use VITE_ prefixes.
HEALER_CIPHERTEXT_STORAGE=local
KUBO_API_URL=
PINATA_JWT=

# Local Docker integrations (enable with --profile integrations).
# Mailpit accepts SMTP on 1025 and exposes its inbox at http://localhost:8025.
# Kubo exposes its API on 5001; use http://ipfs:5001 inside Compose.
# Prometheus exposes its dashboard at http://localhost:9090.
